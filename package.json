{
  "name": "putio-manager",
  "version": "2.0.1",
  "private": true,
  "description": "Cross-platform put.io desktop manager",
  "main": "dist/desktop/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "build": "tsc && tsc -p tsconfig.ui.json && node scripts/copy-assets.mts",
    "test:api": "node --test tests/api.test.cjs",
    "test:downloads": "node --test tests/downloads.test.cjs",
    "test:rules": "node --test tests/rules.test.cjs",
    "test:settings": "node --test tests/settings.test.cjs",
    "test:device-auth": "node --test tests/device-auth.test.cjs",
    "test": "npm run test:api && npm run test:downloads && npm run test:rules && npm run test:settings && npm run test:integration && npm run test:device-auth && npm run test:engine && npm run test:remote && npm run test:platform",
    "test:ui": "electron . --smoke-test",
    "start": "electron .",
    "package": "electron-packager . PutioManager --out=release --overwrite --ignore=\"^/(?!dist($|/)|package.json$)\" --protocol=magnet --protocol-name=\"Magnet links\" --icon=src/ui/branding/putio-manager",
    "verify": "npm run typecheck && npm run build && npm test && npm run test:ui",
    "test:integration": "node --test tests/integration.test.cjs",
    "test:package": "node scripts/test-package.mts",
    "test:engine": "node --test tests/engine.test.cjs",
    "test:remote": "node --test tests/remote.test.cjs tests/cli.test.cjs",
    "test:ui-assets": "node scripts/test-ui-assets.mts",
    "test:platform": "node --test tests/platform.test.cjs tests/setup.test.cjs",
    "package:distribution": "node scripts/package-distribution.mts",
    "test:distribution": "node scripts/test-distribution.mjs",
    "test:distribution:gui": "node scripts/test-distribution.mjs --gui",
    "release:archive": "node scripts/archive-distribution.mjs",
    "release:checksums": "node scripts/release-checksums.mjs",
    "verify:public": "node scripts/verify-public-release.mjs source"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "24.10.13",
    "electron": "45.2.3",
    "typescript": "7.0.2"
  },
  "license": "GPL-3.0-only"
}
